# Generate two DIFFERENT long random tokens; never use these explanatory strings.
PORTAL_API_TOKEN=
PORTAL_RUNNER_TOKEN=
# Keep localhost for a tunnel on the same machine. For remote LAN testing only,
# explicitly set PORTAL_BIND_ADDRESS=0.0.0.0 and protect access with your firewall.
PORTAL_BIND_ADDRESS=127.0.0.1
PORTAL_PORT=8080
# On the training computer: HTTPS URL reachable from that computer.
PORTAL_URL=https://trainer.example.com
RUNNER_ID=rtx-runner-1
# A trusted ORIGINAL training checkpoint, not a converted/inference checkpoint.
YOLO_WEIGHTS=/weights/yolov9-s.pt
# Set YOLO_WEIGHTS= explicitly for a training-from-scratch smoke test.
# For published images use the same immutable Git SHA tag on both computers:
# PORTAL_MANAGER_IMAGE=ghcr.io/fry2412/frigate/training-manager:sha-<full-commit>
# PORTAL_RUNNER_IMAGE=ghcr.io/fry2412/frigate/training-runner:sha-<full-commit>
